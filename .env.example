# Copy to .env and edit. Never commit .env.

# Pin a released version tag (releases: https://github.com/docling-project/docling-serve/releases)
# v1.30.0 was the latest GitHub release I could confirm; check the tag exists on quay.io
DOCLING_VERSION=v1.30.0

# Any long random string, e.g.: openssl rand -hex 24
DOCLING_API_KEY=

# Sizing: for a 16 GB VM use 12g / 2 workers; for an 8 GB VM use 6g / 1 worker
DOCLING_MEM_LIMIT=6g
DOCLING_WORKERS=1

# Optional
# DOCLING_ENABLE_UI=0
